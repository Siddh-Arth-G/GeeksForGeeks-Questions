//////////Solution

class Solution {
    public boolean isBipartite(int V, int[][] edges) {
        // Code here
        ArrayList<ArrayList<Integer>> adjList = new ArrayList<>();
        for(int i=0; i<V; i++){
            adjList.add(new ArrayList<>());
        }
        
        for(int[] edge: edges){
            adjList.get(edge[0]).add(edge[1]);
            adjList.get(edge[1]).add(edge[0]);
        }
        
        int[] color = new int[V];
        
        for(int i=0; i<V; i++){
            if(color[i] == 0){
                if(!bipartite(i, adjList, color)){
                    return false;
                }
            }
        }
        return true;
    }
    
    boolean bipartite(int start, ArrayList<ArrayList<Integer>> adjList, int[] color){
        Queue<Integer> q = new LinkedList<>();
        q.add(start);
        color[start] = 1;
        
        while(!q.isEmpty()){
            int node = q.remove();
            for(int neighbour : adjList.get(node)){
                if(color[neighbour] == 0){
                    color[neighbour] = color[node] == 1 ? 2 : 1;
                    q.add(neighbour);
                } else if(color[neighbour] == color[node]){
                    return false;
                }
            }
        }
        return true;
    }
}
