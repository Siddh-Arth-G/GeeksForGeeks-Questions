// User function Template for Java
class Solution {
    public int findDuplicate(int[] arr) {
        // code here
         int cnt=0;
        int i=0;
        while(cnt<arr.length && arr[i]!=0){
            int temp=arr[i];
            arr[i]=0;
            i=temp;
            cnt++;
        }
        return i;
    }
}
