//////////Solution

class Solution {
    public int findUnique(int[] arr) {
        // code here
        int n = arr.length;
        
        int sum = 0;
        Set<Integer> set = new HashSet<>();
        
        for(int num : arr) {
            sum +=  num;
            set.add(num);
        }
        
        int calSum = 0;
        for(int num : set) {
            calSum += num;
        }
        
        return (2 * calSum) - sum;
    }
}
