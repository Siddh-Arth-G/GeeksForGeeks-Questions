class Solution {

    ArrayList<Integer> nthRowOfPascalTriangle(int n) {
        // code here
        ArrayList<Integer> row = new ArrayList<>();
        row.add(1);
        
        if (n == 1) {
            return row;
        }
        
        ArrayList<Integer> prevRow = nthRowOfPascalTriangle(n - 1);
        
        for (int i = 1; i < prevRow.size(); i++) {
            row.add(prevRow.get(i - 1) + prevRow.get(i));
        }
        
        row.add(1);
        return row;
    }
}
